# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local)
LLM_PROVIDER=openai           # openai or gemini
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_BEAM_SIZE=1         # 1 = greedy (fastest, ~3-5x faster on CPU), 5 = high precision
LOCAL_WHISPER_CPU_THREADS=8       # Number of CPU threads to utilize for transcription
FETCH_YOUTUBE_SUBTITLES_FIRST=true # Instantly fetch YouTube captions in ~1s instead of full audio Whisper
LOCAL_OUTPUT_DIR=output
